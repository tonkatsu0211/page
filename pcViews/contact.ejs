<script>
  function sendMail() {
    const email = "contact@tonkatsu.f5.si";
    const subject = "ホームページ「お問い合わせ」より";
  
    const mailtoLink = `mailto:${email}?subject=${encodeURIComponent(subject)}`;
    const webFallback = `https://outlook.office.com/mail/0/deeplink/compose?to=${encodeURIComponent(email)}&subject=${encodeURIComponent(subject)}`;
  
    let switched = false;
  
    const handleVisibilityChange = () => {
      if (document.hidden) {
        switched = true;
      }
    };
  
    document.addEventListener("visibilitychange", handleVisibilityChange);
  
    window.location.href = mailtoLink;
  
    setTimeout(() => {
      document.removeEventListener("visibilitychange", handleVisibilityChange);
  
      if (!switched) {
        window.open(webFallback, "_blank", "noopener");
      }
    }, 2000);
  }
</script>

  
